# Numba/JAX JIT compilation cache (machine+version-tagged, see
# dispsolver/_jit_cache.py -- must never be committed, a cache built on
# one machine/numba-version is not portable and could be silently stale
# on another)
.cache/

# Solver output caches (derived; go stale when the model changes)
examples/*_u.npy

# Solver result files (derived; regenerate by re-running the example)
examples/*_result.pkl
examples/*.vtkhdf

# Debug / temporary large binary files (dbg*.pkl, crash_state.npz 등)
examples/dbg*.pkl
examples/dbg*.npz
examples/*.png
examples/*.jpg
examples/results/*.pkl
scratch/*.npz
scratch/*.pkl
scratch/*.log
scratch/*.png
scratch/*.jpg
