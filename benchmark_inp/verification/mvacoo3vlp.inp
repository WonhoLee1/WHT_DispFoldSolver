4,1,1
3,1,1,.2
2,1,1,.2
*END LOAD CASE
*LOAD CASE,name = "uniaxial tension-3"
*CLOAD
3,1,1000
2,1,1000
*END LOAD CASE
*EL PRINT
S,E
EE, 
*OUTPUT,FIELD
*NODE OUTPUT,VARIABLE=PRESELECT
*ELEMENT OUTPUT,VARIABLE=PRESELECT
*END STEP

